# Скопіюйте у .env і змініть під себе (run_windows.bat робить це сам при першому запуску)

# --- Джерело даних ---
# mt5       : бот сам бере M1-історію із запущеного терміналу MetaTrader 5.
#             Працює лише на Windows (run_windows.bat), не в Docker.
# csv       : файли експорту барів з MT5 (Ctrl+U -> Бари -> M1 -> Експорт); для Docker/Linux/Mac
# dukascopy : безкоштовні котирування Dukascopy, без ключа
DATA_SOURCE=csv
SYMBOLS=EURUSD,GBPUSD
DATE_FROM=2024-01-01
# порожньо = до сьогодні
DATE_TO=

# --- MetaTrader 5 (DATA_SOURCE=mt5) ---
# Залиште порожніми, щоб використати акаунт, у який термінал уже залогінений
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Шлях до terminal64.exe, якщо терміналів кілька (інакше порожньо)
MT5_PATH=
# Назви символів у брокера, якщо вони з суфіксом (EURUSD.m, EURUSDx ...)
MT5_SYMBOL_EURUSD=EURUSD
MT5_SYMBOL_GBPUSD=GBPUSD
# Час сервера: ny_close = NY+7h (GMT+2/+3 з літнім часом США, як у більшості брокерів);
# інакше назва зони, напр. UTC або Europe/London
MT5_SERVER_TZ=ny_close

# --- CSV (DATA_SOURCE=csv; шляхи всередині Docker, ./data = /app/data).
# Можна кілька файлів-шматків: зірочка підхопить EURUSD_M1_1.csv, EURUSD_M1_2.csv ...
CSV_EURUSD=/app/data/EURUSD_M1*.csv
CSV_GBPUSD=/app/data/GBPUSD_M1*.csv

# --- Dukascopy (DATA_SOURCE=dukascopy) ---
DUKASCOPY_FETCH_ASK=true

# --- Ризик (PRO-правила, Q4) ---
RISK_PCT=0.3
DAILY_MAX_LOSS_PCT=1.5
DAILY_MAX_SL=5
MAX_LOSSES_SAME_PLACE=3
STARTING_BALANCE=10000

# --- Вихід (Q5, Q6) ---
MIN_RR=2
FIXED_TP_R=4
# варіант стопу для детальної статистики: a | b | c | d
BE_MODE=c
# які варіанти порівнювати (v5: c = після часткової 2R стоп у беззбиток на новому M5-свінгу)
BE_MODES=c

# --- Фільтри (true/false) ---
# REQUIRE_D1_BIAS=true      (STRATEGY задає сам; v3: false)
# REQUIRE_PREMIUM_DISCOUNT=true
# REQUIRE_POI_OR_MAJOR=true

# --- Готова стратегія: course | v1 | v2 | v3 | v4 | v5_core | v5 | v6 (рекомендовано v6 = v5 + друга пара в той самий бік з ризиком ×0.5) ---
STRATEGY=v6
# Ризик угоди AF відносно базового (v5: 0.5)
# CFG_AF_RISK_MULT=0.5

# --- Тонке налаштування поверх STRATEGY (будь-яке поле Config: CFG_<НАЗВА>=значення) ---
# CFG_KILLZONE_SET=extended
# CFG_MIN_SL_PIPS=5
# CFG_TP_MODE=fixed3
# CFG_MAX_SPREAD_FRAC=0.12
# CFG_KZ_RISK_MULT={"ASIA":0.5}   # множник ризику за кілзоною ({} = вимкнено)
# CFG_AF_SYMBOLS=["EURUSD"]       # AF лише на цих парах (порожньо = усі)
# CFG_BLOCK_SAME_DIRECTION=false  # дозволити дві пари в один бік (за замовчуванням true)
# CFG_CORR_SECOND_RISK_MULT=0.5   # друга пара в той самий бік з половинним ризиком (0 = блокувати)
# CFG_FILL_THROUGH_PIPS=0.2       # стрес-тест: ліміт виконується після проходу ціни крізь рівень (0 = вимкнено)
# Нові моделі v0.7 (вимкнені за замовчуванням):
# CFG_SESSION_POOLS=true          # London H/L як пули ліквідності
# CFG_SWEEP_POOLS=["ASIA","LON"]  # Session Raid: лише свіп сесійних діапазонів
# CFG_PO3_MAX_PIPS=30             # PO3: свіп нижче/вище NY-midnight open <= 30 пп
# CFG_ALLOW_CONTINUATION=true     # S11: вхід на вищому лоу після свіпу
# CFG_MAX_HOLD_MIN=120            # тайм-стоп після входу
# CFG_NEWS_MODE=block             # off | block | after | no_day
# CFG_NEWS_SCOPE=high             # high | tier1

# --- Новини (ForexFactory) ---
# Календар уже вшитий у пакет (news/ff_calendar.csv, до кінця 2026).
# Оновити: docker compose run --rm news   -> data/news/ff_calendar.csv
# NEWS_CSV=/app/data/news/my_calendar.csv
# NEWS_TZ=UTC

# --- Експерименти (python -m smcbot experiments) ---
# Угоди до цієї дати = in-sample (на них обираємо), з цієї дати = out-of-sample (перевірка)
OOS_FROM=2026-01-01

# --- Шляхи і логи (Docker; run_windows.bat підставляє локальні папки сам) ---
DATA_DIR=/app/data
RESULTS_DIR=/app/results
LOG_LEVEL=INFO
